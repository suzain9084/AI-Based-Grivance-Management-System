# Database — default + per-service overrides
CONNECTION_STRING=mysql+pymysql://grievance_svc_db:Suzain%40123@localhost/grievance_db
USER_CONNECTION_STRING=mysql+pymysql://user_svc:User%40123@localhost/user_db
GRIEVANCE_CONNECTION_STRING=mysql+pymysql://grievance_svc:Suzain%401234@localhost/grievance_db
ADMIN_CONNECTION_STRING=mysql+pymysql://grievance_svc_db:Suzain%40123@localhost/grievance_db

# JWT (must be identical across all services)
JWT_SECRET=dev-jwt-secret-change-in-production
JWT_EXPIRY_HOURS=24

# Service ports
USER_SERVICE_PORT=5000
GRIEVANCE_SERVICE_PORT=5001
ADMIN_SERVICE_PORT=5002
API_GATEWAY_PORT=5003

# Internal service hosts (used by API gateway)
USER_SERVICE_HOST=127.0.0.1
GRIEVANCE_SERVICE_HOST=127.0.0.1
ADMIN_SERVICE_HOST=127.0.0.1

# Flask
FLASK_DEBUG=True

# ML / external APIs
GEMINI_API_KEY=your_gemini_api_key
