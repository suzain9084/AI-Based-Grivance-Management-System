# All backend secrets live here. Copy to backend/.env and fill in your values.

# Default database (used when a service-specific connection is not set)
CONNECTION_STRING=mysql+pymysql://grievance_svc:password@localhost/grievance_db

# Optional per-service database overrides
USER_CONNECTION_STRING=mysql+pymysql://user_svc:password@localhost/user_db
GRIEVANCE_CONNECTION_STRING=mysql+pymysql://grievance_svc:password@localhost/grievance_db
ADMIN_CONNECTION_STRING=mysql+pymysql://admin_svc:password@localhost/admin_db
NOTIFICATION_CONNECTION_STRING=mysql+pymysql://notification_svc:password@localhost/notification_db

# JWT (must be identical across all services)
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRY_HOURS=24

# Service ports
USER_SERVICE_PORT=5000
GRIEVANCE_SERVICE_PORT=5001
ADMIN_SERVICE_PORT=5002
ML_SERVICE_PORT=5003
NOTIFICATION_SERVICE_PORT=5004
API_GATEWAY_PORT=8080

# Internal service hosts (used by API gateway)
USER_SERVICE_HOST=127.0.0.1
GRIEVANCE_SERVICE_HOST=127.0.0.1
ADMIN_SERVICE_HOST=127.0.0.1
ML_SERVICE_HOST=127.0.0.1
NOTIFICATION_SERVICE_HOST=127.0.0.1

# RabbitMQ (Docker container — backend connects via published host port)
# Example: docker run -d --name rabbitmq -p 5672:5672 -p 15672:15672 rabbitmq:3-management
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_VHOST=/
# Optional single URL (overrides host/port/user/password/vhost above):
# RABBITMQ_URL=amqp://guest:guest@localhost:5672/
NOTIFICATION_QUEUE=notifications

# Flask
FLASK_DEBUG=True

# ML / external APIs
GEMINI_API_KEY=your_gemini_api_key
