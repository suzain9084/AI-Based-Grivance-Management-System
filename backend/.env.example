# Database
CONNECTION_STRING=mysql+pymysql://root:your_password@localhost/grievance_management_system_db

# JWT (must be identical across all services)
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRY_HOURS=24

# Service ports
USER_SERVICE_PORT=5000
GRIEVANCE_SERVICE_PORT=5001
ADMIN_SERVICE_PORT=5002

# Flask
FLASK_DEBUG=True

# ML / external APIs
GEMINI_API_KEY=your_gemini_api_key
